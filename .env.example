# Copy this file to .env.local for local development. Do not commit real values.
APP_URL=http://localhost:3000
DATABASE_URL=
NEXTAUTH_SECRET=
FILE_STORAGE_LOCATION=/data/files
FILE_STORAGE_ENCRYPTION_ENABLE=0
FILE_STORAGE_ENCRYPTION_KEY=
# Optional persistent cache for downloaded file contents. Keep this outside the primary storage.
# FILE_STORAGE_DISK_CACHE_DIR=/data/file-cache
# FILE_STORAGE_DISK_CACHE_SIZE_MB=1024
# FILE_STORAGE_DISK_CACHE_TTL_SECONDS=604800
# FILE_STORAGE_DISK_CACHE_ENCRYPTION_KEY=
ENABLE_SIGNUP=0
OPENAPI_TOOL_REQUIRE_CONFIRM=1
CHAT_ATTACHMENTS_MAX_SIZE=50000000
